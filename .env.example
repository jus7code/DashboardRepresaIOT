# Copie a .env y complete. Use contraseñas alfanuméricas (van dentro de URLs).
# Dominio propio: p. ej. el DNS de la IP pública de la VM de Azure
#   DOMAIN=represa-santander.eastus.cloudapp.azure.com
# Para pruebas locales: DOMAIN=:80
DOMAIN=:80

MQTT_USER=represa
MQTT_PASS=cambiar
POSTGRES_PASSWORD=cambiar
INGEST_KEY=cambiar
ADMIN_TOKEN=cambiar

AZURE_MAPS_KEY=
AZURE_MAPS_LAT=7.0170
AZURE_MAPS_LON=-73.4160

# Opcional: análisis de gráficas con IA (Claude)
ANTHROPIC_API_KEY=
